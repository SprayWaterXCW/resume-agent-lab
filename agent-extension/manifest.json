{
  "manifest_version": 3,
  "name": "Resume Agent Lab · 模型自主决策",
  "version": "0.1.7",
  "description": "LangGraph 状态与模型逐步选工具；普通 Chrome 简历填写，禁止自动提交。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "dist/worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "profile-editor.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Resume Agent Lab",
    "default_popup": "popup.html"
  }
}
